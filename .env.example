ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# "iex" works on free Alpaca accounts; use "sip" if your account is entitled to it
ALPACA_DATA_FEED=iex

POLL_INTERVAL_SECONDS=30

# Risk-based position sizing: a 1-ATR adverse move costs this fraction of equity
RISK_PER_TRADE_PCT=0.01
# Hard stop-loss cap, also expressed as a fraction of account equity
HARD_STOP_PCT=0.01

TRADES_CSV=trades.csv
DAILY_PNL_CSV=daily_pnl.csv

# Free tier: 25 requests/day, 5/min. Each request returns full earnings history for one symbol.
ALPHA_VANTAGE_API_KEY=
